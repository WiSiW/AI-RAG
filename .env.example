# Copy to .env and replace every secret before starting.

ZHIYUAN_ENVIRONMENT=development
ZHIYUAN_SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
ZHIYUAN_ADMIN_USERNAME=admin
ZHIYUAN_ADMIN_PASSWORD=change-me

ZHIYUAN_DATABASE_URL=postgresql+psycopg://zhiyuan:zhiyuan@postgres:5432/zhiyuan
ZHIYUAN_REDIS_URL=redis://redis:6379/0
ZHIYUAN_CELERY_BROKER_URL=redis://redis:6379/1
ZHIYUAN_CELERY_RESULT_BACKEND=redis://redis:6379/2

ZHIYUAN_MINIO_ENDPOINT=minio:9000
ZHIYUAN_MINIO_ACCESS_KEY=minioadmin
ZHIYUAN_MINIO_SECRET_KEY=minioadmin
ZHIYUAN_MINIO_BUCKET=zhiyuan
ZHIYUAN_MINIO_SECURE=false
ZHIYUAN_MINIO_REGION=us-east-1

ZHIYUAN_MILVUS_URI=http://milvus:19530
ZHIYUAN_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
ZHIYUAN_AUTO_CREATE_TABLES=true
ZHIYUAN_UPLOAD_MAX_MB=2048
ZHIYUAN_ARCHIVE_MAX_MB=4096
ZHIYUAN_UPLOAD_TEMP_DIR=/app/data/uploads
ZHIYUAN_IMPORT_ROOT=/app/data/imports
ZHIYUAN_PUBLIC_BASE_URL=
ZHIYUAN_PUBLIC_FILE_EXPIRE_MINUTES=60
ZHIYUAN_MODEL_REQUEST_TIMEOUT=120
ZHIYUAN_SESSION_WINDOW_SIZE=10
ZHIYUAN_SUMMARY_TRIGGER_MESSAGES=16
ZHIYUAN_SUMMARY_KEEP_MESSAGES=8
ZHIYUAN_RAG_MULTI_KB_FINAL_TOP_K=6
ZHIYUAN_RAG_GLOBAL_CANDIDATE_TOP_K=60
ZHIYUAN_RAG_MULTI_KB_RERANK_THRESHOLD=0.3
ZHIYUAN_RAG_MULTI_KB_MAX_CONTEXT_TOKENS=6000
ZHIYUAN_RAG_MAX_CONCURRENCY=8

